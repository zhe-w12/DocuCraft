HOST=0.0.0.0
PORT=5000

# 本地开发使用 mock；生产部署应通过 generic_http 连接自建 OCR 服务。
OCR_PROVIDER=mock
MOCK_OCR_TEXT=这是开发环境的占位识别结果，请配置自建 OCR 服务后替换。
OCR_ENDPOINT=
OCR_API_KEY=

# 本地开发默认写入后端 storage 目录；生产可配置 aliyun_oss。
STORAGE_BACKEND=local
STORAGE_DIR=storage
PUBLIC_BASE_URL=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=scan-convert
OSS_URL_EXPIRE_SECONDS=3600
MAX_UPLOAD_MB=20
MAX_SOURCE_IMAGE_MB=100
MAX_IMAGE_PIXELS=50000000
LIBREOFFICE_BIN=soffice

# AI 写作与修改助手（密钥仅保存在服务端）
# 阿里云百炼北京地域 OpenAI 兼容 Chat Completions 接口
AI_PROVIDER=bailian
AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max
# 可选联网搜索（LangChain + Tavily）；密钥仅存在于后端环境。
TAVILY_API_KEY=
# 文档工作流最大输出 token（默认 16384，qwen3.8-max 上限 131072）；闲聊固定为 4096。
AI_MAX_OUTPUT_TOKENS=16384
AI_CHAT_REQUESTS_PER_MINUTE=10
AI_CHAT_MAX_CONCURRENT=4
AI_CHAT_MAX_CONCURRENT_PER_CLIENT=2
OCR_REQUESTS_PER_MINUTE=6
OCR_MAX_CONCURRENT=2
OCR_MAX_CONCURRENT_PER_CLIENT=1
DOCUMENT_EXPORT_REQUESTS_PER_MINUTE=10
DOCUMENT_EXPORT_MAX_CONCURRENT=3
DOCUMENT_EXPORT_MAX_CONCURRENT_PER_CLIENT=1
DOCUMENT_REFRESH_REQUESTS_PER_MINUTE=30
DOCUMENT_REFRESH_MAX_CONCURRENT=4
DOCUMENT_REFRESH_MAX_CONCURRENT_PER_CLIENT=2
